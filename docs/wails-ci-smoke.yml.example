# Example GitHub Actions job for Wails smoke (copy into .github/workflows/ when
# the pushing credential has the `workflow` scope). Electron ci.yml stays default.
name: Wails smoke
on:
  pull_request:
    paths: ['dsh-plugin-desktop/wails/**']
  workflow_dispatch:
permissions:
  contents: read
jobs:
  go-build:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: dsh-plugin-desktop/wails
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - uses: actions/setup-go@v5
        with:
          go-version: '1.27.x'
          cache-dependency-path: dsh-plugin-desktop/wails/go.sum
      - name: Install Linux webview build deps
        run: |
          sudo apt-get update
          sudo apt-get install -y libgtk-3-dev libwebkit2gtk-4.1-dev || sudo apt-get install -y libgtk-3-dev libwebkit2gtk-4.0-dev
      - run: go test ./...
      - run: go build -o bin/dsh-wails-shell .
      - name: package script fallback
        working-directory: ${{ github.workspace }}/dsh-plugin-desktop
        run: node ./wails/scripts/run-wails.mjs package
